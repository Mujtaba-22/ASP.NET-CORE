@using Microsoft.AspNetCore.Http.Features
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@model Product

<h2>@SharedLocalizer["EditProduct"]</h2>

  <div class="container">
    <div class="row d-flex justify-content-center align-items-center">
        <div class="col-md-6">
            <div class="card p-5">
                <form asp-action="Edit" method="post">
                 <input type="hidden" asp-for="Id" />
      <div class="mb-4">
                    <label class="form-label fw-semibold">
                        @SharedLocalizer["Categories"]
                    </label>
                    <select name="CategoryId" class="form-select">

                        <option value="">@SharedLocalizer["SelectCategories"]</option>

                        @foreach (var item in ViewBag.categories)
                        {
                            <option value="@item.Id">

                                @item.Name

                            </option>
                        }

                    </select>

                </div>
    <div class="form-group mb-3">
        <label asp-for="Name">@(SharedLocalizer["ProductName"])</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price">@SharedLocalizer["Price"]</label>
        <input asp-for="Price" class="form-control" />
    </div>
    
     <div class="form-group mb-3">
        <label asp-for="Images">@SharedLocalizer["Image"]</label>
        <input asp-for="Images" class="form-control" />
    </div>


    <button type="submit" class="btn btn-primary">@SharedLocalizer["SaveChanges"]</button>
    <a asp-action="Index" class="btn btn-secondary">@SharedLocalizer["Cancel"]</a>
</form>
            </div>
        </div>
    </div>
  </div>